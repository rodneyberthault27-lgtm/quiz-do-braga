# Copie para .env no desenvolvimento local. Em producao, cadastre cada uma
# destas no painel do Railway (servico do app -> aba Variables).
# Nunca comite o .env preenchido.

# Injetada automaticamente pelo Railway ao vincular o servico Postgres.
# Localmente, aponte para o seu Postgres.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/quizdobraga

# Segredo de assinatura da sessao. Gere um valor aleatorio longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# URL publica da aplicacao, sem barra no fim. E a base do notification_url
# que o Mercado Pago vai chamar, entao precisa ser a URL real de producao.
APP_URL=https://seu-app.up.railway.app

# Credenciais do Mercado Pago (painel do vendedor -> Suas integracoes).
# Use as de teste enquanto valida o fluxo.
MERCADO_PAGO_ACCESS_TOKEN=
# Gerado ao cadastrar o webhook no painel do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# Preco em centavos. 4990 = R$ 49,90.
PRECO_CENTAVOS=4990
PRODUTO_NOME=Quiz do Braga - acesso completo

# Quantas perguntas a amostra gratuita libera.
AMOSTRA_GRATIS=10

# Este e-mail vira administrador ao se cadastrar. Cadastre-se com ele primeiro.
ADMIN_EMAIL=

NODE_ENV=production
